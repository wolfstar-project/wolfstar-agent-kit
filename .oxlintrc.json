{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "plugins": ["import", "oxc", "typescript", "vue"],
  "rules": {
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-debugger": "error",
    "no-unused-vars": "error",
    "prefer-const": [
      "error",
      {
        "ignoreReadBeforeAssign": true
      }
    ],
    "require-yield": "off"
  },
  "ignorePatterns": ["**/.generated/**", "**/test/fixtures/**"]
}
