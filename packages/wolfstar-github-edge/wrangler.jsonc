{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wolfstar-github-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // The GitHub App webhook uses the workers.dev hostname, and the Access application covers it.
  // The dashboard has its own custom domain, which the same Access application covers.
  // A preview URL would be a hostname outside Access, so previews stay off.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "agent.wolfstar.rocks", "custom_domain": true }],
  // The dashboard build. The Worker checks Access first, then serves it, so the interface loads with the controller down.
  "assets": {
    "directory": "../wolfstar-github-agent/dashboard/.output/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    // The controller serves /sessions, not /sessions/, so the build does too.
    "html_handling": "drop-trailing-slash",
  },
  "vars": {
    // Where webhooks and the dashboard go: the controller's public https origin, with no path.
    "CONTROLLER_URL": "https://controller.wolfstar.rocks",
    // Cloudflare Access in front of every route but /webhook. Clear both to turn the check off.
    "ACCESS_TEAM_DOMAIN": "https://wolfstar.cloudflareaccess.com",
    "ACCESS_AUD": "808350b0ce80d953105d631f4e9db423289eb1e973f45de04eb38ca53341242e",
  },
  // The Container and its Durable Object held the controller. Version 2 removes the class and its stored setup.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ControllerContainer"] },
    { "tag": "v2", "deleted_classes": ["ControllerContainer"] },
  ],
  "queues": {
    "producers": [{ "binding": "WEBHOOKS", "queue": "wolfstar-github-webhooks" }],
    "consumers": [
      {
        "queue": "wolfstar-github-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 20,
        "dead_letter_queue": "wolfstar-github-webhooks-dlq",
      },
    ],
  },
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "wolfstar-github-agent-state" }],
}
