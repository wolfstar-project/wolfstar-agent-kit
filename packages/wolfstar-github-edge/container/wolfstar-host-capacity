#!/usr/bin/env node

/**
 * The host capacity command for a host with one account, such as the Container.
 *
 * On Hogwild a root broker shares one machine between accounts and GitHub
 * Actions runners, and decides which maintenance Task may start. A Container
 * holds one controller and nothing else, and the controller already limits its
 * own Agents to the slot count it set. So this command keeps the policy the
 * controller states, reports it back, and runs an admitted command as is.
 *
 *   status                          the policy in force
 *   policy <slots> <reserve>        record the policy, then report it
 *   run <scope> <GiB> <command...>  run the command, as the broker does once admitted
 *
 * The controller checks the answer to `policy` against what it asked, so a
 * wrong reply stops its start instead of running with a policy nobody set.
 *
 * Agent sessions from the dashboard reserve a slot with the terminal
 * commands below. The controller starts each session helper as a detached
 * process, and `bind` records the helper that called it, by PID and start
 * time, so a reused PID never passes for a live session.
 *
 *   capacity <GiB>                  what a new session would get
 *   reserve | reserve-manual <json> hold a slot for one session
 *   bind <json>                     tie the reservation to the calling helper
 *   reconcile agent <key>           whether that helper still runs
 *   release agent <key>             forget a reservation whose helper exited
 *   cancel <json>                   forget a reservation no helper bound
 *   completed <json>                whether a reservation finished and was forgotten
 */

import { spawn } from 'node:child_process'
import { randomUUID } from 'node:crypto'
import { closeSync, mkdirSync, openSync, readFileSync, renameSync, statSync, unlinkSync, writeFileSync } from 'node:fs'
import { homedir, hostname } from 'node:os'
import { join } from 'node:path'

const stateDirectory =
  process.env.WOLFSTAR_HOST_CAPACITY_STATE || join(homedir(), '.local', 'state', 'wolfstar-host-capacity')
const policyPath = join(stateDirectory, 'policy.json')
const reservationsPath = join(stateDirectory, 'reservations.json')
const lockPath = join(stateDirectory, 'lock')
/** A helper binds within seconds of its start. One that never bound has exited. */
const UNBOUND_MILLISECONDS = 120_000

function readFirstLine(path) {
  try {
    const value = readFileSync(path, 'utf8').trim()
    return value === '' ? null : value
  } catch {
    return null
  }
}

function readPolicy() {
  try {
    const value = JSON.parse(readFileSync(policyPath, 'utf8'))
    if (Number.isSafeInteger(value.agentSlots) && Number.isSafeInteger(value.maintenanceReserve)) return value
  } catch {
    // No policy yet. The controller sets one before it starts work.
  }
  return { agentSlots: 0, maintenanceReserve: 0 }
}

function status() {
  return {
    _tag: 'Status',
    hostId: readFirstLine('/etc/machine-id') || hostname() || 'container',
    // A new value after every boot tells the controller its earlier reservations are gone.
    bootId: readFirstLine('/proc/sys/kernel/random/boot_id') || randomUUID(),
    policy: readPolicy(),
  }
}

function fail(message) {
  process.stderr.write(`${message}\n`)
  process.exit(2)
}

function wholeNumber(text, name) {
  if (!/^\d{1,3}$/.test(text ?? '')) fail(`${name} must be a whole number.`)
  return Number(text)
}

function writeAtomically(path, value) {
  mkdirSync(stateDirectory, { recursive: true, mode: 0o700 })
  // Write beside the target and rename, so a reader never sees half a file.
  const next = `${path}.${process.pid}`
  writeFileSync(next, JSON.stringify(value), { mode: 0o600 })
  renameSync(next, path)
}

function readReservations() {
  try {
    const value = JSON.parse(readFileSync(reservationsPath, 'utf8'))
    if (typeof value === 'object' && value !== null && !Array.isArray(value)) return value
  } catch {
    // No session has reserved anything yet.
  }
  return {}
}

/** Runs one change to the reservations with no other call in between. */
function withReservations(change) {
  mkdirSync(stateDirectory, { recursive: true, mode: 0o700 })
  const deadline = Date.now() + 5_000
  for (;;) {
    try {
      closeSync(openSync(lockPath, 'wx', 0o600))
      break
    } catch (error) {
      if (error.code !== 'EEXIST') throw error
      // A call that died holding the lock leaves it behind. No call holds it for long.
      try {
        if (Date.now() - statSync(lockPath).mtimeMs > 30_000) unlinkSync(lockPath)
      } catch {
        // Another call removed it first.
      }
      if (Date.now() > deadline) fail('The reservations are locked.')
      Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 25)
    }
  }
  try {
    const reservations = readReservations()
    const result = change(reservations)
    writeAtomically(reservationsPath, reservations)
    return result
  } finally {
    unlinkSync(lockPath)
  }
}

/** The start time of a live process, or null once it exited. Field 22 of `/proc/<pid>/stat`. */
function processStartTime(pid) {
  const stat = readFirstLine(`/proc/${pid}/stat`)
  if (stat === null) return null
  const fields = stat.slice(stat.lastIndexOf(')') + 2).split(' ')
  if (fields[0] === 'Z' || fields[0] === 'X') return null
  return fields[19] ?? null
}

function scopeAlive(scope) {
  const match = /^process:(\d+):(\d+)$/.exec(scope.controlGroup)
  return match !== null && processStartTime(Number(match[1])) === match[2]
}

function gibibytes(kibibytes) {
  return Math.floor((kibibytes / 1024 / 1024) * 10) / 10
}

function hostMemory() {
  const values = {}
  try {
    for (const line of readFileSync('/proc/meminfo', 'utf8').split('\n')) {
      const match = /^(\w+):\s+(\d+) kB$/.exec(line)
      if (match) values[match[1]] = Number(match[2])
    }
  } catch {
    // Not Linux. The memory is unknown and no session waits on it.
  }
  if (values.MemTotal === undefined || values.MemAvailable === undefined) return null
  return { totalGiB: gibibytes(values.MemTotal), availableGiB: gibibytes(values.MemAvailable) }
}

/** Reservations whose helper may still run. One that exited holds nothing until the controller releases it. */
function held(reservations) {
  return Object.values(reservations).filter(alive)
}

function decide(reservations, requestedGiB) {
  const { agentSlots } = readPolicy()
  const observed = hostMemory()
  if (held(reservations).length >= agentSlots) return { _tag: 'AtCapacity', reason: 'Slots' }
  if (observed !== null && observed.availableGiB < requestedGiB) return { _tag: 'AtCapacity', reason: 'MemoryPressure' }
  return { _tag: 'Allowed' }
}

function capacity(requestedGiB) {
  const reservations = readReservations()
  const policy = readPolicy()
  const observed = hostMemory()
  const reservedGiB = held(reservations).reduce((total, entry) => total + entry.memoryGiB, 0)
  return {
    _tag: 'Capacity',
    memoryGiB: Math.max(1, Math.floor(observed?.totalGiB ?? 1)),
    reservedGiB,
    agentSlots: policy.agentSlots,
    agentSlotsUsed: held(reservations).length,
    maintenanceReserve: policy.maintenanceReserve,
    forcedGiB: 0,
    sessionMemoryGiB: requestedGiB,
    memory:
      observed === null
        ? { _tag: 'Unknown', reason: 'The host does not report its memory.' }
        : { _tag: 'Physical', ...observed },
    // One account owns this host, so no one can override its limits.
    manualPolicy: { _tag: 'Disabled' },
    regular: decide(reservations, requestedGiB),
    manual: { _tag: 'Unavailable', reason: 'This host has no manual override.' },
  }
}

function json(text) {
  try {
    const value = JSON.parse(text ?? '')
    if (typeof value === 'object' && value !== null && !Array.isArray(value)) return value
  } catch {
    // Reported below.
  }
  fail('The argument must be a JSON object.')
}

function reserve(input) {
  const { requestId, fingerprint, key, memoryGiB, unit } = input
  if (![requestId, fingerprint, key, unit].every((value) => typeof value === 'string') || !Number.isFinite(memoryGiB))
    fail('A reservation needs requestId, fingerprint, key, unit, and memoryGiB.')
  return withReservations((reservations) => {
    const existing = reservations[key]
    const { hostId, bootId } = status()
    if (existing !== undefined) {
      return existing.requestId === requestId && existing.fingerprint === fingerprint
        ? { _tag: 'Admitted', reservationId: existing.reservationId, disposition: 'Existing', unit, hostId, bootId }
        : { _tag: 'Conflict' }
    }
    const decision = decide(reservations, memoryGiB)
    if (decision._tag !== 'Allowed') return decision
    const reservationId = randomUUID()
    reservations[key] = { reservationId, requestId, fingerprint, unit, memoryGiB, createdAt: Date.now(), scope: null }
    return { _tag: 'Admitted', reservationId, disposition: 'Created', unit, hostId, bootId }
  })
}

function bind(input) {
  const { key, reservationId, unit, invocationId } = input
  return withReservations((reservations) => {
    const existing = reservations[key]
    if (existing === undefined) return { _tag: 'Missing' }
    if (existing.reservationId !== reservationId || existing.unit !== unit) return { _tag: 'Conflict' }
    if (existing.scope !== null && existing.scope.invocationId !== invocationId) return { _tag: 'Conflict' }
    // The helper runs this command itself, so its parent is the process the reservation belongs to.
    const startTime = processStartTime(process.ppid)
    if (startTime === null) return { _tag: 'Conflict' }
    existing.scope = { unit, invocationId, controlGroup: `process:${process.ppid}:${startTime}` }
    return { _tag: 'Bound', reservationId, scope: existing.scope }
  })
}

function alive(entry) {
  return entry.scope === null ? Date.now() - entry.createdAt < UNBOUND_MILLISECONDS : scopeAlive(entry.scope)
}

function reconcile(key) {
  const entry = readReservations()[key]
  if (entry === undefined) return { _tag: 'Missing' }
  return alive(entry) ? { _tag: 'Alive', reservationId: entry.reservationId, scope: entry.scope } : { _tag: 'Empty' }
}

function release(key) {
  return withReservations((reservations) => {
    const entry = reservations[key]
    if (entry === undefined) return { _tag: 'Missing' }
    if (alive(entry)) return { _tag: 'Unknown', reason: 'The session still runs.' }
    delete reservations[key]
    return { _tag: 'Empty' }
  })
}

function cancel(input) {
  return withReservations((reservations) => {
    const entry = reservations[input.key]
    if (entry === undefined) return { _tag: 'Empty' }
    if (entry.reservationId !== input.reservationId || entry.scope !== null) return { _tag: 'Conflict' }
    delete reservations[input.key]
    return { _tag: 'Empty' }
  })
}

function completed(input) {
  // A reservation is forgotten only once its helper exited, and a Container restart ends every helper.
  return readReservations()[input.key] === undefined ? { _tag: 'Completed' } : { _tag: 'Conflict' }
}

function answer(value) {
  process.stdout.write(`${JSON.stringify(value)}\n`)
}

const [command, ...rest] = process.argv.slice(2)

if (command === 'status') {
  answer(status())
} else if (command === 'policy') {
  const agentSlots = wholeNumber(rest[0], 'The slot count')
  const maintenanceReserve = wholeNumber(rest[1], 'The maintenance reserve')
  if (agentSlots > 256 || maintenanceReserve > agentSlots) fail('The policy is outside what this host can hold.')
  writeAtomically(policyPath, { agentSlots, maintenanceReserve })
  answer(status())
} else if (command === 'capacity') {
  answer(capacity(wholeNumber(rest[0], 'The memory')))
} else if (command === 'reserve' || command === 'reserve-manual') {
  answer(command === 'reserve' ? reserve(json(rest[0])) : { _tag: 'Unavailable', reason: 'This host has no manual override.' })
} else if (command === 'bind') {
  answer(bind(json(rest[0])))
} else if (command === 'reconcile' && rest[0] === 'agent' && rest[1]) {
  answer(reconcile(rest[1]))
} else if (command === 'release' && rest[0] === 'agent' && rest[1]) {
  answer(release(rest[1]))
} else if (command === 'cancel') {
  answer(cancel(json(rest[0])))
} else if (command === 'completed') {
  answer(completed(json(rest[0])))
} else if (command === 'run') {
  const [scope, memory, ...argv] = rest
  if (!scope || argv.length === 0) fail('Usage: run <scope> <GiB> <command...>')
  wholeNumber(memory, 'The memory')
  // The worker refuses to start without proof of admission, which the Hogwild broker also hands over
  // as a reservation. Nothing queues here, so each admitted command is its own reservation.
  // stdio is inherited, so the worker's event stream and the proof channel pass straight through.
  const child = spawn(argv[0], argv.slice(1), {
    stdio: 'inherit',
    env: { ...process.env, WOLFSTAR_HOST_RESERVATION: randomUUID() },
  })
  for (const signal of ['SIGTERM', 'SIGINT']) process.on(signal, () => child.kill(signal))
  child.once('error', (error) => fail(`Could not start the command: ${error.message}`))
  child.once('close', (code, signal) => process.exit(code ?? (signal === null ? 1 : 128)))
} else {
  fail('Usage: status | policy <slots> <reserve> | run <scope> <GiB> <command...> | capacity <GiB> | reserve <json> | bind <json> | reconcile agent <key> | release agent <key> | cancel <json> | completed <json>')
}
