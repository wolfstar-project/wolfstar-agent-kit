{
  "name": "wolfstar-github-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Local service for Wolfstar Project's GitHub agents.",
  "license": "MIT",
  "bin": {
    "wolfstar-github-agent": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "pnpm dashboard:build && obuild",
    "dashboard:build": "nuxt generate dashboard",
    "dashboard:dev": "nuxt dev dashboard",
    "dev": "node --experimental-strip-types src/cli.ts",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "start": "node dist/cli.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit && nuxt typecheck dashboard"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@coldtea/pr-lens-renderer": "catalog:",
    "@coldtea/pr-lens-schema": "catalog:",
    "@openai/codex-sdk": "catalog:",
    "advocaat": "workspace:*",
    "citty": "catalog:",
    "consola": "catalog:",
    "h3": "catalog:",
    "octokit": "catalog:",
    "srvx": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@iconify-json/octicon": "catalog:",
    "@iconify-json/simple-icons": "catalog:",
    "@nuxt/fonts": "catalog:",
    "@nuxt/icon": "catalog:",
    "@nuxt/ui": "catalog:",
    "@types/node": "catalog:",
    "@vueuse/nuxt": "catalog:",
    "nuxt": "catalog:",
    "nuxt-skew-protection": "catalog:",
    "obuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
